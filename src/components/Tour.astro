---
---

<section class="section tour" id="tour">
  <div class="shell tgrid">
    <div class="copy reveal">
      <span class="eyebrow">The longer look · 89 seconds</span>
      <h2 class="h-section">Watch a full session.</h2>
      <p class="lede">The original tour: browse files, inspect previews, rename a batch and switch themes. Recorded in the real app.</p>
    </div>
    <div class="frame vid reveal">
      <video controls preload="none" playsinline poster="/media/tour.jpg">
        <source src="/media/tour.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<style>
  .tgrid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); gap: 40px; align-items: center; padding-top: 32px; border-top: 1px solid var(--line); }
  .copy { display: grid; gap: 18px; }
  .copy .h-section { font-size: clamp(1.8rem, 3vw, 2.4rem); }
  .vid { aspect-ratio: 16 / 9; }
  .vid video { background: var(--crust); }
  @media (max-width: 960px) { .tgrid { grid-template-columns: minmax(0, 1fr); } }
</style>
