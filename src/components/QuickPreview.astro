---
// Quick preview (Space) on real files from the demo home. Each shot is the
// overlay as HyprFM draws it, metadata sidebar included.
const shots = [
  { still: 'peek-0', label: 'code-reviewer.jpg', note: 'Photos carry their camera EXIF: make, model, exposure, aperture, ISO.' },
  { still: 'peek-3', label: 'pair-programmer.jpg', note: 'Arrow keys move to the next file without closing the overlay.' },
  { still: 'peek-1', label: 'my-first-rice-1946.jpg', note: 'Dimensions, megapixels and bit depth for every image.' },
  { still: 'qp-music', label: 'lofi-beats-to-rice-to.mp3', note: 'Music shows its tags: title, artist, album, genre, year.' },
  { still: 'qp-video', label: 'launching-hyprfm.mp4', note: 'Video gets a poster frame, codec, resolution and frame rate.' },
  { still: 'qp-pdf-1', label: 'thesis-final-FINAL-v3.pdf', note: 'PDFs page with ↑ and ↓, with author, producer and page size.' },
  { still: 'qp-pdf-3', label: 'thesis · page 3', note: 'Page three, chart and all. The thesis is fictional.' },
  { still: 'qp-md', label: 'todo.md', note: 'Markdown renders here too.' },
];
---

<section class="section qp" id="quick-preview">
  <div class="shell">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Quick preview</span>
        <h2 class="h-section"><span class="space">Space</span> peeks at <em>anything.</em></h2>
      </div>
      <p class="lede">Select a file, press Space. A full overlay opens with the file and its metadata side by side, and the arrow keys walk the folder while it stays open. Space or Esc closes it.</p>
    </div>

    <div class="viewer reveal">
      <div class="frame stagebox">
        {shots.map((s, i) => <img src={`/media/s/${s.still}.webp`} alt={`Quick preview of ${s.label}`} class={i === 0 ? 'on' : ''} width="2000" height="1250" loading="lazy" decoding="async" />)}
      </div>
      <p class="caption"><code id="qp-label">{shots[0].label}</code> <span id="qp-note">{shots[0].note}</span></p>
      <div class="strip" role="tablist" aria-label="Files to preview">
        {shots.map((s, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i} data-label={s.label} data-note={s.note}>
            <img src={`/media/s/${s.still}.webp`} alt="" width="200" height="125" loading="lazy" decoding="async" />
            <span>{s.label}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var tabs = [].slice.call(document.querySelectorAll('.qp .strip button'));
    var big = [].slice.call(document.querySelectorAll('.qp .stagebox img'));
    function go(i) {
      tabs.forEach(function (t, j) { t.setAttribute('aria-selected', String(i === j)); });
      big.forEach(function (im, j) { im.classList.toggle('on', i === j); });
      document.getElementById('qp-label').textContent = tabs[i].dataset.label;
      document.getElementById('qp-note').textContent = tabs[i].dataset.note;
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { go(i); });
      t.addEventListener('keydown', function (e) {
        var n = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : null;
        if (n === null) return;
        e.preventDefault(); n = (n + tabs.length) % tabs.length; go(n); tabs[n].focus();
      });
    });
  })();
</script>

<style>
  .space { font-family: var(--mono); font-size: .62em; vertical-align: .18em; padding: .1em .45em; border-radius: 12px;
    background: var(--surface); box-shadow: 0 5px 0 var(--crust); margin-right: .1em; }
  .stagebox { aspect-ratio: 16 / 10; }
  .stagebox img { position: absolute; inset: 0; opacity: 0; transition: opacity .18s linear; }
  .stagebox img.on { opacity: 1; }
  .caption { display: flex; gap: 12px; flex-wrap: wrap; align-items: baseline; margin: 18px 0 22px; color: var(--subtext); }
  .caption code { color: var(--accent); font-size: 14px; }
  .strip { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(140px, 1fr); gap: 12px; overflow-x: auto; padding-bottom: 6px; }
  .strip button { display: grid; gap: 8px; padding: 0; border: 0; background: none; cursor: pointer; text-align: left; color: var(--muted); }
  .strip img { border-radius: 8px; aspect-ratio: 16 / 10; object-fit: cover; width: 100%; opacity: .55; box-shadow: 0 0 0 1px var(--line); transition: opacity .15s; }
  .strip span { font: 12px var(--mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .strip button:hover img { opacity: .85; }
  .strip button[aria-selected='true'] img { opacity: 1; box-shadow: 0 0 0 2px var(--accent); }
  .strip button[aria-selected='true'] span { color: var(--text); }
  @media (prefers-reduced-motion: reduce) { .stagebox img { transition: none; } }
</style>
