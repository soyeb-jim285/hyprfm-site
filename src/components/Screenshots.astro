---
const views = [
  { id: 'grid', key: 'Ctrl 1', name: 'Grid', title: 'Visual when you need it.', body: 'Scan folders, images, and documents at a glance. Resize the grid with Ctrl+Scroll and move naturally with arrow keys.', src: '/screenshots/grid-view.png', alt: 'HyprFM Grid view with folders and project files' },
  { id: 'miller', key: 'Ctrl 2', name: 'Miller', title: 'Context in every column.', body: 'Move through deep trees while keeping parent folders and a syntax-highlighted file preview in view.', src: '/screenshots/miller-view.png', alt: 'HyprFM Miller view with three columns and source preview' },
  { id: 'preview', key: 'Space', name: 'Quick Preview', title: 'Open less. Know more.', body: 'Inspect a file and its metadata in place, then browse nearby items with the arrow keys.', src: '/screenshots/quick-preview.png', alt: 'HyprFM Quick Preview showing an image and detailed metadata' },
];
---

<section id="showcase" class="section overflow-hidden border-b border-surface0 bg-mantle/40">
  <div class="shell">
    <div class="mb-14 flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
      <div class="reveal"><p class="eyebrow mb-5">Two views · one quick preview</p><h2 class="text-[clamp(2.7rem,6vw,5.6rem)] font-semibold leading-[0.95] tracking-[-0.06em]">Choose your focus.</h2></div>
      <div class="flex flex-wrap border border-surface1 reveal" role="tablist" aria-label="HyprFM views">
        {views.map((view, index) => <button type="button" role="tab" data-view-tab={view.id} data-active={index === 0 ? 'true' : 'false'} aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`view-${view.id}`} tabindex={index === 0 ? 0 : -1} class="border-r border-surface1 px-4 py-3 text-sm text-subtext0 transition last:border-r-0 hover:text-text data-[active=true]:bg-text data-[active=true]:text-base">{view.name}</button>)}
      </div>
    </div>

    <div class="reveal" data-view-showcase>
      {views.map((view, index) => (
        <article id={`view-${view.id}`} data-view-panel={view.id} role="tabpanel" hidden={index !== 0}>
          <div class="window">
            <div class="window-bar justify-between"><span class="font-mono text-[0.65rem] text-overlay0">VIEW / {view.name.toUpperCase()}</span><span class="key">{view.key}</span></div>
            <img src={view.src} alt={view.alt} class="aspect-[16/9] w-full object-cover object-top" loading="lazy" width="2528" height="1507" />
          </div>
          <div class="mt-8 grid gap-4 md:grid-cols-12 md:items-start">
            <h3 class="text-3xl font-semibold tracking-[-0.04em] md:col-span-5">{view.title}</h3>
            <p class="max-w-2xl leading-relaxed text-subtext0 md:col-span-6 md:col-start-7">{view.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-view-showcase]').forEach((showcase) => {
    const root = showcase.parentElement;
    const tabs = [...root.querySelectorAll('[data-view-tab]')];
    const panels = root.querySelectorAll('[data-view-panel]');
    const activate = (tab) => {
      tabs.forEach((item) => { const active = item === tab; item.dataset.active = String(active); item.setAttribute('aria-selected', String(active)); item.tabIndex = active ? 0 : -1; });
      panels.forEach((panel) => { panel.hidden = panel.dataset.viewPanel !== tab.dataset.viewTab; });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        activate(tabs[next]); tabs[next].focus();
      });
    });
  });
</script>
