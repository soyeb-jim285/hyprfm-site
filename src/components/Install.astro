---
import { getLatestVersion } from '../lib/version';
const version = await getLatestVersion();
const flatpakCommand = [
  'flatpak remote-add --user --if-not-exists flathub \\',
  '  https://dl.flathub.org/repo/flathub.flatpakrepo',
  'flatpak remote-add --user --if-not-exists hyprfm \\',
  '  https://flatpak.hyprfm.soyebjim.me/hyprfm.flatpakrepo',
  'flatpak install --user hyprfm io.github.soyeb_jim285.HyprFM',
].join('\n');
const tabs = [
  { id: 'flatpak', label: 'Flatpak', note: 'Recommended outside Arch. Installs the application and required runtime at user scope.', code: flatpakCommand },
  { id: 'aur', label: 'Arch / AUR', note: 'Build the current development version from the AUR.', code: 'yay -S hyprfm-git' },
  { id: 'appimage', label: 'AppImage', note: 'Download the self-contained x86_64 build from the latest release.', code: `wget https://github.com/soyeb-jim285/hyprfm/releases/latest/download/HyprFM-${version}-x86_64.AppImage
chmod +x HyprFM-*.AppImage
./HyprFM-*.AppImage` },
  { id: 'source', label: 'Build source', note: 'Requires Qt 6, CMake, Ninja, and Git submodules.', code: `git clone --recursive https://github.com/soyeb-jim285/hyprfm.git
cd hyprfm
cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTS=OFF
cmake --build build --parallel
./build/src/hyprfm` },
];
---

<section id="install" class="section relative overflow-hidden bg-crust text-text">
  <div class="pointer-events-none absolute inset-0 hairline-grid" aria-hidden="true"></div>
  <div class="shell relative">
    <div class="mb-14 grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7 reveal"><p class="eyebrow mb-5">Get HyprFM · {version}</p><h2 class="text-[clamp(3rem,7vw,6.5rem)] font-semibold leading-[0.9] tracking-[-0.065em]">Ready when<br />your desktop is.</h2></div>
      <div class="lg:col-span-4 lg:col-start-9 reveal reveal-delay-1"><p class="mb-5 leading-relaxed text-subtext0">HyprFM requires a Wayland session. It runs on Hyprland, GNOME, and KDE Plasma.</p><a href="https://github.com/soyeb-jim285/hyprfm/releases" class="inline-flex items-center gap-2 text-sm font-semibold text-blue hover:underline">Read the release notes <span aria-hidden="true">↗</span></a></div>
    </div>

    <div class="border border-surface1 bg-base reveal" data-install-tabs>
      <div class="flex overflow-x-auto border-b border-surface1" role="tablist" aria-label="Installation methods">
        {tabs.map((tab, index) => <button type="button" role="tab" data-install-tab={tab.id} data-active={index === 0 ? 'true' : 'false'} aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`install-${tab.id}`} tabindex={index === 0 ? 0 : -1} class="shrink-0 border-r border-surface1 px-5 py-4 text-sm text-subtext0 transition hover:text-text data-[active=true]:bg-text data-[active=true]:text-base">{tab.label}</button>)}
      </div>
      <div class="p-5 md:p-8">
        {tabs.map((tab, index) => (
          <div id={`install-${tab.id}`} role="tabpanel" data-install-panel={tab.id} hidden={index !== 0}>
            <div class="mb-5 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
              <p class="max-w-2xl text-sm leading-relaxed text-subtext0">{tab.note}</p>
              <button type="button" data-copy-target={`command-${tab.id}`} class="btn-secondary !min-h-10 !px-4"><span data-copy-label>Copy command</span></button>
            </div>
            <div class="overflow-x-auto border border-surface0 bg-crust p-5 md:p-7"><pre id={`command-${tab.id}`} class="min-w-max text-[0.72rem] leading-6 text-subtext1 md:text-sm"><code>{tab.code}</code></pre></div>
          </div>
        ))}
        <p class="sr-only" aria-live="polite" data-copy-status></p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-install-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll('[data-install-tab]')];
    const panels = root.querySelectorAll('[data-install-panel]');
    const activate = (tab) => {
      tabs.forEach((item) => { const active = item === tab; item.dataset.active = String(active); item.setAttribute('aria-selected', String(active)); item.tabIndex = active ? 0 : -1; });
      panels.forEach((panel) => { panel.hidden = panel.dataset.installPanel !== tab.dataset.installTab; if (!panel.hidden) panel.classList.add('tab-enter'); });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        activate(tabs[next]); tabs[next].focus();
      });
    });
    root.querySelectorAll('[data-copy-target]').forEach((button) => button.addEventListener('click', async () => {
      const target = document.getElementById(button.dataset.copyTarget);
      const label = button.querySelector('[data-copy-label]');
      const status = root.querySelector('[data-copy-status]');
      try {
        await navigator.clipboard.writeText(target.textContent.trim());
        label.textContent = 'Copied'; status.textContent = 'Install command copied to clipboard.';
      } catch {
        label.textContent = 'Copy failed'; status.textContent = 'Could not copy the install command.';
      }
      window.setTimeout(() => { label.textContent = 'Copy command'; }, 1800);
    }));
  });
</script>
