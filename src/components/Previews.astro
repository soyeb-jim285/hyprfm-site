---
// The preview pane, cropped out of real Miller-view recordings of the demo home.
// `how` names what HyprFM uses to render it (src/services/previewservice.cpp).
const groups = [
  { dir: '~/Code/rice-o-meter', files: [
    { name: 'main.rs', still: 'prev-code-main.rs', kind: 'Rust', how: 'Highlighted by bat, in the theme’s colours.' },
    { name: 'rice.py', still: 'prev-code-rice.py', kind: 'Python', how: 'Highlighted by bat. Any language bat knows works.' },
    { name: 'style.css', still: 'prev-code-style.css', kind: 'CSS', how: 'Highlighted by bat.' },
    { name: 'Cargo.toml', still: 'prev-code-Cargo.toml', kind: 'TOML', how: 'Config formats are highlighted too.' },
    { name: 'README.md', still: 'prev-code-README.md', kind: 'Markdown', how: 'Rendered with md4c: headings, lists and code fences.' },
  ] },
  { dir: '~/Documents', files: [
    { name: 'todo.md', still: 'prev-doc-todo.md', kind: 'Markdown', how: 'Rendered Markdown. The checklist is honest.' },
    { name: 'thesis-final-FINAL-v3.pdf', still: 'prev-doc-thesis-final', kind: 'PDF', how: 'Page one rendered by Poppler, with title, pages and page size.' },
    { name: 'rice-budget.csv', still: 'prev-doc-rice-budget', kind: 'CSV', how: 'Tabular text, highlighted by column.' },
    { name: 'excuses.txt', still: 'prev-doc-excuses', kind: 'Text', how: 'Plain text, first 128 KB.' },
  ] },
  { dir: '~/Downloads', files: [
    { name: 'dotfiles-from-reddit.zip', still: 'prev-dl-dotfiles', kind: 'Archive', how: 'Contents listed without extracting: zip, tar, 7z, rar.' },
    { name: 'hyprland-0.99-NIGHTLY.tar.gz', still: 'prev-dl-hyprland-0', kind: 'Archive', how: 'Compressed tarballs list their contents too.' },
    { name: 'definitely-not-a-virus.AppImage', still: 'prev-dl-definitely', kind: 'Binary', how: 'Some files keep their secrets.' },
  ] },
  { dir: '~/Fonts · ~/Videos · ~/Code', files: [
    { name: 'FiraCode-Regular.ttf', still: 'prev-font-0', kind: 'Font', how: 'A specimen sheet for TTF, OTF and WOFF files.' },
    { name: 'JetBrainsMono-Regular.ttf', still: 'prev-font-1', kind: 'Font', how: 'Glyphs, sizes and ligatures at a glance.' },
    { name: 'launching-hyprfm.mp4', still: 'prev-video', kind: 'Video', how: 'A poster frame from ffmpeg, plus codec and resolution.' },
    { name: 'Code/', still: 'prev-folder', kind: 'Folder', how: 'Folders preview their first 40 entries.' },
  ] },
];
const first = groups[0].files[0];
---

<section class="section" id="previews">
  <div class="shell">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Miller columns · live preview</span>
        <h2 class="h-section">Every file <em>previews itself.</em></h2>
      </div>
      <p class="lede">Arrow onto a file and the third column shows what is inside it. Code, Markdown, PDFs, archives, fonts and media, with no app to open and nothing to close. Pick one of the ricer’s files to see the real pane.</p>
    </div>

    <div class="inspector reveal">
      <div class="files" role="listbox" aria-label="Files in the demo home" tabindex="0" id="pv-list" aria-activedescendant="pv-0-0">
        {groups.map((g, gi) => (
          <div class="group">
            <div class="dir">{g.dir}</div>
            {g.files.map((f, fi) => (
              <div class="file" role="option" id={`pv-${gi}-${fi}`} aria-selected={gi === 0 && fi === 0 ? 'true' : 'false'}
                data-still={f.still} data-how={f.how} data-name={f.name}>
                <span class="nm">{f.name}</span><span class="kind">{f.kind}</span>
              </div>
            ))}
          </div>
        ))}
      </div>
      <figure class="pane">
        <div class="frame crop"><img id="pv-img" src={`/media/s/${first.still}.webp`} alt={`HyprFM preview pane showing ${first.name}`} width="2000" height="1250" loading="lazy" /></div>
        <figcaption><code id="pv-name">{first.name}</code><span id="pv-how">{first.how}</span></figcaption>
      </figure>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var list = document.getElementById('pv-list');
    var items = [].slice.call(list.querySelectorAll('.file'));
    var img = document.getElementById('pv-img');
    items.forEach(function (it) { it._src = '/media/s/' + it.dataset.still + '.webp'; });
    function pick(it, focus) {
      items.forEach(function (x) { x.setAttribute('aria-selected', String(x === it)); });
      list.setAttribute('aria-activedescendant', it.id);
      img.src = it._src;
      img.alt = 'HyprFM preview pane showing ' + it.dataset.name;
      document.getElementById('pv-name').textContent = it.dataset.name;
      document.getElementById('pv-how').textContent = it.dataset.how;
      if (focus) it.scrollIntoView({ block: 'nearest' });
    }
    items.forEach(function (it) { it.addEventListener('click', function () { pick(it); }); });
    list.addEventListener('keydown', function (e) {
      var i = items.findIndex(function (x) { return x.getAttribute('aria-selected') === 'true'; });
      if (e.key === 'ArrowDown' || e.key === 'j') { e.preventDefault(); pick(items[Math.min(items.length - 1, i + 1)], true); }
      if (e.key === 'ArrowUp' || e.key === 'k') { e.preventDefault(); pick(items[Math.max(0, i - 1)], true); }
    });
  })();
</script>

<style>
  .inspector { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 28px; align-items: start; }
  .files { background: var(--mantle); border: 1px solid var(--line); border-radius: 14px; padding: 10px; font-family: var(--mono); font-size: 13.5px; max-height: 640px; overflow-y: auto; }
  .files:focus-visible { outline-offset: 2px; }
  .group + .group { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); }
  .dir { color: var(--muted); font-size: 12px; padding: 4px 10px 6px; }
  .file { display: flex; justify-content: space-between; gap: 12px; padding: 7px 10px; border-radius: 8px; cursor: pointer; color: var(--subtext); }
  .file:hover { background: color-mix(in srgb, var(--surface) 55%, transparent); color: var(--text); }
  .file[aria-selected='true'] { background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--text); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 55%, transparent); }
  .nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .kind { color: var(--muted); font-size: 11.5px; flex: none; }
  .pane { margin: 0; display: grid; gap: 14px; }
  /* crop the recording down to the preview column (x 56.25–100%, under the toolbar) */
  .crop { aspect-ratio: 700 / 918; max-height: 720px; margin-inline: auto; width: 100%; max-width: 560px; }
  .crop img { position: absolute; width: 228.571%; height: auto; left: -128.571%; top: -5.66%; max-width: none; }
  figcaption { display: flex; flex-direction: column; gap: 4px; max-width: 560px; margin-inline: auto; width: 100%; }
  figcaption code { font-size: 13px; color: var(--accent); }
  figcaption span { color: var(--subtext); }
  @media (max-width: 860px) {
    .inspector { grid-template-columns: minmax(0, 1fr); }
    .files { max-height: 300px; }
  }
</style>
