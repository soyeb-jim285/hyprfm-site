---
import shortcuts from '../data/shortcuts.json';
// Generated from HyprFM's defaults (src/services/configmanager.cpp).
const groups = [...new Set(shortcuts.map((s) => s.group))].map((g) => ({ g, items: shortcuts.filter((s) => s.group === g) }));
const split = (k: string) => k.split('+').filter(Boolean);
---

<section class="section cheats" id="shortcuts">
  <div class="shell">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">{shortcuts.length} defaults · all rebindable</span>
        <h2 class="h-section">The whole <em>keyboard</em>, on one page.</h2>
      </div>
      <div class="find">
        <label for="sc-q" class="sr-only">Filter shortcuts</label>
        <input id="sc-q" type="search" placeholder="Filter: rename, tab, split…" autocomplete="off" spellcheck="false" />
        <p class="lede">The same list as HyprFM’s own Ctrl+? dialog.</p>
      </div>
    </div>
    <div class="cols reveal">
      {groups.map(({ g, items }) => (
        <div class="col">
          <h3>{g}</h3>
          <ul>
            {items.map((s) => (
              <li data-q={`${s.label} ${s.keys} ${s.action}`.toLowerCase()}>
                <span>{s.label}</span>
                <span class="keys">{split(s.keys).map((k, i) => <>{i > 0 && <span class="plus">+</span>}<kbd class="key">{k}</kbd></>)}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="none" id="sc-none" hidden>No shortcut matches that. Every action is listed in config.toml, too.</p>
  </div>
</section>

<script is:inline>
  (function () {
    var q = document.getElementById('sc-q');
    var rows = [].slice.call(document.querySelectorAll('.cheats li'));
    var cols = [].slice.call(document.querySelectorAll('.cheats .col'));
    q.addEventListener('input', function () {
      var v = q.value.trim().toLowerCase(), any = false;
      rows.forEach(function (r) { var hit = !v || r.dataset.q.indexOf(v) >= 0; r.hidden = !hit; any = any || hit; });
      cols.forEach(function (c) { c.hidden = !c.querySelector('li:not([hidden])'); });
      document.getElementById('sc-none').hidden = any;
    });
  })();
</script>

<style>
  .find { display: grid; gap: 12px; }
  input { width: 100%; font: 15px var(--mono); color: var(--text); background: var(--mantle); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; }
  input::placeholder { color: var(--muted); }
  input:focus { outline: none; border-color: var(--accent); }
  .cols { columns: 3 300px; column-gap: 36px; }
  .col { break-inside: avoid; margin-bottom: 30px; }
  h3 { font: 600 12px var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 0; border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent); font-size: 15px; color: var(--subtext); }
  li .keys { font-size: 12px; flex: none; }
  .none { color: var(--muted); }
</style>
