---
const shortcuts = [
  ['Ctrl', 'L', 'Edit the current path'],
  ['Space', '', 'Open Quick Preview'],
  ['Ctrl', 'T', 'Create a new tab'],
  ['F3', '', 'Toggle split view'],
  ['Ctrl', 'F', 'Search this location'],
  ['Ctrl', 'Z', 'Undo the last operation'],
];
---

<section id="shortcuts" class="section border-b border-surface0">
  <div class="shell grid gap-16 lg:grid-cols-12">
    <div class="lg:col-span-5 reveal">
      <p class="eyebrow mb-5">Keyboard first, not keyboard only</p>
      <h2 class="mb-7 text-[clamp(2.7rem,5vw,5rem)] font-semibold leading-[0.96] tracking-[-0.06em]">Stay in the flow.</h2>
      <p class="max-w-md text-lg leading-relaxed text-subtext1">Navigate, select, preview, search, and operate on files without breaking your train of thought. Every shortcut is configurable.</p>
      <div class="mt-12 border-l-2 border-blue pl-5"><p class="font-mono text-sm text-subtext0">Start typing in any view</p><p class="mt-1 text-xl font-semibold">Type-ahead finds the match.</p></div>
    </div>
    <div class="border-t border-surface0 lg:col-span-6 lg:col-start-7 reveal reveal-delay-1">
      {shortcuts.map(([modifier, key, action], index) => (
        <div class="group grid grid-cols-[7rem_1fr] items-center border-b border-surface0 py-5 transition hover:pl-2">
          <div class="flex gap-1"><span class="key">{modifier}</span>{key && <span class="key">{key}</span>}</div>
          <div class="flex items-center justify-between gap-4"><span class="text-sm text-subtext1 group-hover:text-text">{action}</span><span class="font-mono text-xs text-overlay0">0{index + 1}</span></div>
        </div>
      ))}
    </div>
  </div>
</section>
