---
interface Props { version: string }
const { version } = Astro.props;

// Real frames of HyprFM, recorded in CI (hyprfm repo: brag/capture/site.sh).
const miller = ['aurora-from-orbit.jpg', 'cosmic-cliffs-8k.jpg', 'great-wave-but-dark.jpg', 'monet-with-blur-on.jpg',
  'orbital-sunrise-final2.jpg', 'starry-night-tiled.jpg', 'tokaido-nord-theme.jpg'].map((name, i) => ({ src: `/media/s/hero-w${i}.webp`, name }));
const peek = ['code-reviewer.jpg', 'my-first-rice-1946.jpg', 'my-setup-from-orbit.jpg', 'pair-programmer.jpg',
  'senior-engineer.jpg', 'vacuum-tube-refactor.jpg'].map((name, i) => ({ src: `/media/s/peek-${i}.webp`, name }));
const methods = [
  { id: 'arch', label: 'Arch', cmd: 'yay -S hyprfm-git' },
  { id: 'flatpak', label: 'Flatpak', cmd: 'flatpak install --user hyprfm io.github.soyeb_jim285.HyprFM' },
  { id: 'nix', label: 'Nix', cmd: 'nix run github:soyeb-jim285/hyprfm' },
  { id: 'appimage', label: 'AppImage', cmd: `./HyprFM-${version}-x86_64.AppImage` },
];
---

<section class="hero" id="top">
  <div class="shell">
    <div class="statement">
      <div class="opening reveal">
        <p class="project-note">Open source · Qt 6 / QML · Wayland</p>
        <h1>A file manager for Wayland.</h1>
        <p class="lede">Browse with the keyboard. Preview without opening. Keep your terminal, files and theme in one place.</p>
        <div class="actions"><a class="get" href="#install">Install HyprFM <span aria-hidden="true">↓</span></a><a href="https://github.com/soyeb-jim285/hyprfm">Read the source ↗</a></div>
      </div>
      <div class="side reveal">
        <p class="install-label">Install from your terminal</p>
        <div class="install">
          <div class="distro" role="group" aria-label="Install method">
            {methods.map((m, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-cmd={m.cmd}>{m.label}</button>)}
          </div>
          <div class="cmd"><code id="hero-cmd">{methods[0].cmd}</code><button type="button" id="hero-copy">Copy</button></div>
          <a class="more" href="#install">Setup instructions for every package →</a>
        </div>
      </div>
    </div>

    <div class="stage reveal" id="try">
      <div class="frame window" id="hero-win" role="img" aria-label="HyprFM, recorded. Use the arrow keys and Space to step through it.">
        {miller.map((f, i) => <img src={f.src} alt="" data-set="miller" data-name={f.name} class={i === 0 ? 'on' : ''} width="2000" height="1250" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />)}
        {peek.map((f) => <img src={f.src} alt="" data-set="peek" data-name={f.name} width="2000" height="1250" loading="lazy" decoding="async" />)}
      </div>
      <div class="controls">
        <p class="state"><span class="eyebrow" id="hero-mode">Miller columns</span> <code id="hero-file">{miller[0].name}</code></p>
        <div class="pad">
          <span class="hint">Try it:</span>
          <button class="key" type="button" data-k="ArrowUp" aria-label="Up">↑</button>
          <button class="key" type="button" data-k="ArrowDown" aria-label="Down">↓</button>
          <button class="key" type="button" data-k="ArrowLeft" aria-label="Left">←</button>
          <button class="key" type="button" data-k="ArrowRight" aria-label="Right">→</button>
          <button class="key wide" type="button" data-k=" ">Space</button>
          <button class="key" type="button" data-k="Escape">Esc</button>
          <button class="play" id="hero-play" type="button" aria-pressed="false">Play demo</button>
        </div>
      </div>
      <p class="note">Interactive walkthrough using real app captures. Arrow keys change the selection; Space opens a preview.</p>
    </div>

    <dl class="facts reveal">
      <div><dt>Views</dt><dd>Grid, Miller & list</dd></div>
      <div><dt>Appearance</dt><dd>10 bundled themes</dd></div>
      <div><dt>Desktop</dt><dd>Wayland native</dd></div>
      <div><dt>Source</dt><dd>MIT licensed</dd></div>
    </dl>
  </div>
</section>

<script is:inline>
  (function () {
    var win = document.getElementById('hero-win');
    var sets = { miller: [].slice.call(win.querySelectorAll('[data-set="miller"]')), peek: [].slice.call(win.querySelectorAll('[data-set="peek"]')) };
    var mode = 'miller', idx = { miller: 0, peek: 0 }, timer = null;
    function show() {
      var cur = sets[mode][idx[mode]];
      win.querySelectorAll('img').forEach(function (im) { im.classList.toggle('on', im === cur); });
      document.getElementById('hero-mode').textContent = mode === 'miller' ? 'Miller columns' : 'Quick preview';
      document.getElementById('hero-file').textContent = cur.dataset.name;
    }
    function press(k) {
      var b = document.querySelector('.pad .key[data-k="' + k + '"]');
      if (b) { b.classList.add('down'); setTimeout(function () { b.classList.remove('down'); }, 130); }
      var list = sets[mode], i = idx[mode];
      if (k === ' ') mode = mode === 'miller' ? 'peek' : 'miller';
      else if (k === 'Escape') mode = 'miller';
      else if (k === 'ArrowDown' || (mode === 'peek' && k === 'ArrowRight')) idx[mode] = mode === 'peek' ? (i + 1) % list.length : Math.min(list.length - 1, i + 1);
      else if (k === 'ArrowUp' || (mode === 'peek' && k === 'ArrowLeft')) idx[mode] = mode === 'peek' ? (i + list.length - 1) % list.length : Math.max(0, i - 1);
      show();
    }
    var KEYS = ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' ', 'Escape'];
    document.addEventListener('keydown', function (e) {
      if (KEYS.indexOf(e.key) < 0 || e.ctrlKey || e.metaKey || e.altKey) return;
      if (e.target.closest && e.target.closest('input, textarea, select, button, a')) return;
      var r = document.getElementById('try').getBoundingClientRect();
      if (r.bottom < 80 || r.top > innerHeight * 0.6) return;
      e.preventDefault(); stop(); press(e.key);
    });
    document.querySelectorAll('.pad .key').forEach(function (b) { b.addEventListener('click', function () { stop(); press(b.dataset.k); }); });
    // The walkthrough only advances when the visitor asks it to.
    var script = ['ArrowDown', 'ArrowDown', 'ArrowDown', 'ArrowDown', ' ', 'ArrowRight', 'ArrowRight', 'ArrowRight', ' ', 'ArrowUp', 'ArrowUp', 'ArrowUp', 'ArrowUp'], step = 0;
    var play = document.getElementById('hero-play');
    function stop() { if (timer) { clearInterval(timer); timer = null; } play.textContent = 'Play demo'; play.setAttribute('aria-pressed', 'false'); }
    play.addEventListener('click', function () {
      if (timer) { stop(); return; }
      timer = setInterval(function () { press(script[step++ % script.length]); }, 1700);
      play.textContent = 'Pause demo'; play.setAttribute('aria-pressed', 'true');
    });
    document.addEventListener('visibilitychange', function () { if (document.hidden) stop(); });

    document.querySelectorAll('.distro button').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('.distro button').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
        document.getElementById('hero-cmd').textContent = b.dataset.cmd;
      });
    });
    document.getElementById('hero-copy').addEventListener('click', function (e) {
      var el = document.getElementById('hero-cmd');
      navigator.clipboard.writeText(el.textContent).then(function () {
        e.target.textContent = 'Copied'; setTimeout(function () { e.target.textContent = 'Copy'; }, 1400);
      }).catch(function () { var s = getSelection(), r = document.createRange(); r.selectNodeContents(el); s.removeAllRanges(); s.addRange(r); });
    });
  })();
</script>

<style>
  .hero { padding-block: clamp(36px, 5vw, 64px) 36px; }
  .statement { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, .8fr); gap: 32px 64px; align-items: end; margin-bottom: 38px; }
  .opening { display: grid; gap: 20px; }
  .project-note, .install-label { font: 400 12px/1.5 var(--mono); color: var(--subtext); }
  h1 { max-width: 13ch; font: 650 clamp(2.6rem, 5vw, 4.25rem)/1.04 var(--display); letter-spacing: -.05em; text-wrap: balance; }
  .actions { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 4px; }
  .actions a { font-size: 14px; font-weight: 600; text-decoration: none; }
  .get { display: inline-flex; align-items: center; gap: 26px; padding: 11px 17px; background: var(--text); color: var(--crust); border-radius: 6px; }
  .get:hover { background: var(--subtext); }
  .side { display: grid; gap: 14px; padding-bottom: 4px; }
  .lede { color: var(--subtext); max-width: 47ch; font-size: 16px; }
  .install { display: grid; gap: 10px; }
  .distro { display: flex; gap: 6px; flex-wrap: wrap; }
  .distro button { font: 400 11px var(--mono); color: var(--subtext); background: none; border: 1px solid var(--line); border-radius: 5px; padding: 7px 10px; cursor: pointer; }
  .distro button[aria-pressed='true'] { color: var(--crust); background: var(--text); border-color: var(--text); }
  .cmd { display: flex; align-items: center; gap: 12px; background: var(--mantle); border: 1px solid var(--line); border-radius: 6px; padding: 8px 8px 8px 12px; min-width: 0; }
  .cmd code { font-size: 12px; white-space: nowrap; overflow-x: auto; flex: 1; min-width: 0; scrollbar-width: none; }
  .cmd code::before { content: '$ '; color: var(--success); }
  .cmd button { font-weight: 600; font-size: 12px; color: var(--crust); background: var(--text); border: 0; border-radius: 4px; padding: 7px 10px; cursor: pointer; flex: none; }
  .more { color: var(--subtext); font-size: 12px; text-decoration: none; }
  .more:hover { color: var(--text); }

  .stage { position: relative; }
  .window { aspect-ratio: 16 / 10; }
  .window img { position: absolute; inset: 0; opacity: 0; transition: opacity .12s linear; }
  .window img.on { opacity: 1; }
  .controls { display: flex; justify-content: space-between; align-items: center; gap: 12px 24px; flex-wrap: wrap; padding-top: 16px; }
  .state { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
  .state code { font-size: 11px; color: var(--subtext); }
  .pad { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; font-size: 14px; }
  .pad .key { cursor: pointer; transition: transform .06s, box-shadow .06s; }
  .pad .key.down, .pad .key:active { transform: translateY(3px); box-shadow: 0 0 0 var(--crust), 0 3px 8px var(--shadow); }
  .hint { color: var(--subtext); font-size: 12px; margin-right: 4px; }
  .play { border: 0; border-left: 1px solid var(--line); background: none; padding: 6px 0 6px 12px; margin-left: 6px; cursor: pointer; font-size: 12px; }
  .note { color: var(--subtext); font-size: 12px; margin-top: 12px; }

  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 36px 0 0; border-block: 1px solid var(--line); }
  .facts div { padding: 18px 18px 18px 0; }
  .facts dt { font: 400 11px var(--mono); color: var(--subtext); }
  .facts dd { margin: 4px 0 0; font: 500 14px/1.5 var(--display); }
  @media (max-width: 860px) {
    .statement { grid-template-columns: minmax(0, 1fr); }
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .window img { transition: none; } }
  @media (max-width: 600px) { .state code { display: none; } .side { border-top: 1px solid var(--line); padding-top: 20px; } .facts { column-gap: 20px; } }
</style>
