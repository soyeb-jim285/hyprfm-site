---
const views = [
  { id: 'grid', key: '1', label: 'Grid', still: 'view-grid', text: 'Thumbnails for images, video and PDFs. Ctrl+scroll resizes from two columns to twelve.' },
  { id: 'miller', key: '2', label: 'Miller', still: 'view-miller', text: 'Parent, current and a live preview of whatever is selected, in three columns.' },
  { id: 'detailed', key: '3', label: 'Detailed', still: 'view-detailed', text: 'Sortable columns for size, date and type, with item counts for folders.' },
];
---

<section class="section views" id="views">
  <div class="shell">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Three views · one folder</span>
        <h2 class="h-section">Same files, <em>three ways</em> to read them.</h2>
      </div>
      <p class="lede">Switch with Ctrl+1, Ctrl+2 and Ctrl+3 in the app. Here, press 1, 2 or 3. New tabs open in whichever view you were using.</p>
    </div>
    <div class="switch reveal" role="tablist" aria-label="View">
      {views.map((v, i) => (
        <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i} data-text={v.text}>
          <span class="keys"><span class="key">Ctrl</span><span class="plus">+</span><span class="key">{v.key}</span></span>
          <span class="lbl">{v.label}</span>
        </button>
      ))}
    </div>
    <div class="frame vstage reveal">
      {views.map((v, i) => <img src={`/media/s/${v.still}.webp`} alt={`The Wallpapers folder in HyprFM's ${v.label} view`} class={i === 0 ? 'on' : ''} width="2000" height="1250" loading="lazy" decoding="async" />)}
    </div>
    <p class="vtext" id="v-text">{views[0].text}</p>
  </div>
</section>

<script is:inline>
  (function () {
    var tabs = [].slice.call(document.querySelectorAll('.views .switch button'));
    var imgs = [].slice.call(document.querySelectorAll('.views .vstage img'));
    function go(i) {
      tabs.forEach(function (t, j) { t.setAttribute('aria-selected', String(i === j)); });
      imgs.forEach(function (im, j) { im.classList.toggle('on', i === j); });
      document.getElementById('v-text').textContent = tabs[i].dataset.text;
    }
    tabs.forEach(function (t, i) { t.addEventListener('click', function () { go(i); }); });
    document.addEventListener('keydown', function (e) {
      if (!/^[123]$/.test(e.key) || e.ctrlKey || e.altKey || e.metaKey) return;
      if (e.target.closest && e.target.closest('input, textarea')) return;
      var r = document.getElementById('views').getBoundingClientRect();
      if (r.bottom < 100 || r.top > innerHeight * 0.7) return;
      go(+e.key - 1);
    });
  })();
</script>

<style>
  .switch { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-bottom: 18px; }
  .switch button { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--line); background: var(--mantle); cursor: pointer; font-size: 15px; }
  .switch button[aria-selected='true'] { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .switch .lbl { font: 400 1.6rem/1 var(--display); }
  .switch .keys { font-size: 13px; }
  .vstage { aspect-ratio: 16 / 10; }
  .vstage img { position: absolute; inset: 0; opacity: 0; transition: opacity .2s; }
  .vstage img.on { opacity: 1; }
  .vtext { color: var(--subtext); margin-top: 16px; }
  @media (max-width: 600px) { .switch .keys { display: none; } }
  @media (prefers-reduced-motion: reduce) { .vstage img { transition: none; } }
</style>
