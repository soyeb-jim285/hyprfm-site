---
const views = [
  { id: 'grid', key: '1', label: 'Grid', still: 'view-grid', text: 'Thumbnails for images, video and PDFs. Ctrl+scroll resizes from two columns to twelve.' },
  { id: 'miller', key: '2', label: 'Miller', still: 'view-miller', text: 'Parent, current and a live preview of whatever is selected, in three columns.' },
  { id: 'detailed', key: '3', label: 'Detailed', still: 'view-detailed', text: 'Sortable columns for size, date and type, with item counts for folders.' },
];
---

<section class="section views" id="views">
  <div class="shell">
    <div class="section-head reveal">
      <div>
        <h2 class="h-section">Three views. Same folder.</h2>
      </div>
      <p class="lede">Thumbnails when you need a quick scan. Columns when you’re browsing. A list when the details matter. Switch here, or press 1, 2 or 3.</p>
    </div>
    <div class="switch reveal" role="tablist" aria-label="View">
      {views.map((v, i) => (
        <button type="button" role="tab" id={`view-tab-${v.id}`} aria-controls="view-panel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-i={i} data-text={v.text}>
          <span class="keys"><span class="key">Ctrl</span><span class="plus">+</span><span class="key">{v.key}</span></span>
          <span class="lbl">{v.label}</span>
        </button>
      ))}
    </div>
    <div class="frame vstage reveal" id="view-panel" role="tabpanel" aria-labelledby="view-tab-grid">
      {views.map((v, i) => <img src={`/media/s/${v.still}.webp`} alt={`The Wallpapers folder in HyprFM's ${v.label} view`} class={i === 0 ? 'on' : ''} aria-hidden={i !== 0} width="2000" height="1250" loading="lazy" decoding="async" />)}
    </div>
    <p class="vtext" id="v-text">{views[0].text}</p>
  </div>
</section>

<script is:inline>
  (function () {
    var tabs = [].slice.call(document.querySelectorAll('.views .switch button'));
    var imgs = [].slice.call(document.querySelectorAll('.views .vstage img'));
    function go(i) {
      tabs.forEach(function (t, j) { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      imgs.forEach(function (im, j) { im.classList.toggle('on', i === j); im.setAttribute('aria-hidden', String(i !== j)); });
      document.getElementById('view-panel').setAttribute('aria-labelledby', tabs[i].id);
      document.getElementById('v-text').textContent = tabs[i].dataset.text;
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { go(i); });
      t.addEventListener('keydown', function (e) {
        var next = e.key === 'ArrowRight' ? (i + 1) % tabs.length : e.key === 'ArrowLeft' ? (i + tabs.length - 1) % tabs.length : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : null;
        if (next !== null) { e.preventDefault(); go(next); tabs[next].focus(); }
      });
    });
    document.addEventListener('keydown', function (e) {
      if (!/^[123]$/.test(e.key) || e.ctrlKey || e.altKey || e.metaKey) return;
      if (e.target.closest && e.target.closest('input, textarea')) return;
      var r = document.getElementById('views').getBoundingClientRect();
      if (r.bottom < 100 || r.top > innerHeight * 0.7) return;
      go(+e.key - 1);
    });
  })();
</script>

<style>
  .switch { display: flex; gap: 24px; margin-bottom: 20px; border-bottom: 1px solid var(--line); }
  .switch button { display: flex; align-items: center; gap: 14px; padding: 12px 0; border: 0; border-bottom: 2px solid transparent; background: none; cursor: pointer; font-size: 14px; color: var(--subtext); }
  .switch button[aria-selected='true'] { border-bottom-color: var(--accent); color: var(--text); }
  .switch .lbl { order: -1; font: 600 14px/1.5 var(--body); }
  .switch .keys { font-size: 11px; }
  .vstage { aspect-ratio: 16 / 10; }
  .vstage img { position: absolute; inset: 0; opacity: 0; transition: opacity .2s; }
  .vstage img.on { opacity: 1; }
  .vtext { color: var(--subtext); margin-top: 16px; }
  @media (max-width: 600px) { .switch .keys { display: none; } }
  @media (prefers-reduced-motion: reduce) { .vstage img { transition: none; } }
</style>
