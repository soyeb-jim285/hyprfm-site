---
const details = [
  ['Tabs + split view', 'Keep independent locations and history, reopen closed tabs, or drag files directly between panes.'],
  ['Operations you can reverse', 'Undo and redo copies, moves, renames, bulk renames, trash actions, and newly created items.'],
  ['Search without waiting', 'Run cancellable recursive searches with fd, glob matching, and a threaded Qt fallback.'],
  ['Files beyond local storage', 'Mount removable drives and connect to SFTP, SMB, FTP, mobile devices, and GVFS locations.'],
];
---

<section id="capabilities" class="section border-b border-surface0">
  <div class="shell">
    <div class="mb-16 grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7 reveal">
        <p class="eyebrow mb-5">Built for real file work</p>
        <h2 class="text-[clamp(2.6rem,6vw,5.8rem)] font-semibold leading-[0.95] tracking-[-0.06em]">Less ceremony.<br />More control.</h2>
      </div>
      <p class="max-w-xl text-lg leading-relaxed text-subtext1 lg:col-span-4 lg:col-start-9 reveal reveal-delay-1">HyprFM keeps common actions close, complex operations visible, and every directory navigable without leaving the keyboard.</p>
    </div>

    <div class="grid border-l border-t border-surface0 md:grid-cols-2 lg:grid-cols-12">
      <article class="border-b border-r border-surface0 p-7 md:p-10 lg:col-span-7 reveal">
        <p class="eyebrow mb-20">01 · Organize</p>
        <h3 class="mb-5 max-w-xl text-3xl font-semibold tracking-[-0.04em] md:text-5xl">Transfers that tell you what is happening.</h3>
        <p class="max-w-xl leading-relaxed text-subtext0">Copy and move jobs run concurrently with speed, ETA, conflict handling, and pause, resume, or cancel controls in the Operations Bar.</p>
        <div class="mt-10 flex items-end gap-1" aria-hidden="true">
          <span class="h-3 w-[12%] bg-blue/30"></span><span class="h-3 w-[18%] bg-blue/45"></span><span class="h-3 w-[26%] bg-blue/60"></span><span class="h-3 w-[36%] bg-blue"></span>
        </div>
      </article>

      <article class="border-b border-r border-surface0 bg-mantle/50 p-7 md:p-10 lg:col-span-5 reveal reveal-delay-1">
        <p class="eyebrow mb-20">02 · Preview</p>
        <div class="mb-8 font-mono text-7xl font-medium tracking-[-0.08em] text-blue">SPC</div>
        <h3 class="mb-4 text-2xl font-semibold tracking-[-0.03em]">Inspect before opening.</h3>
        <p class="leading-relaxed text-subtext0">Preview images, PDFs, source code, fonts, video posters, archives, and metadata without changing context.</p>
      </article>

      {details.map(([title, body], index) => (
        <article class:list={['group border-b border-r border-surface0 p-7 transition hover:bg-mantle/60 md:p-9 lg:col-span-3 reveal', `reveal-delay-${(index % 4) + 1}`]}>
          <div class="mb-16 flex items-center justify-between font-mono text-xs text-overlay0"><span>0{index + 3}</span><span class="transition group-hover:translate-x-1 group-hover:text-blue">↗</span></div>
          <h3 class="mb-3 text-xl font-semibold tracking-[-0.025em]">{title}</h3>
          <p class="text-sm leading-relaxed text-subtext0">{body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
