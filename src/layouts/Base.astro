---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'HyprFM — A keyboard-friendly file manager for Wayland',
  description = 'A fast Qt 6 file manager for Hyprland and Wayland desktops, with three views, split panes, rich previews, remote locations, and reversible file operations.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    {/* Apply theme class before first paint to avoid flash */}
    <script is:inline>
      (function () {
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var stored = localStorage.getItem('theme');
        var dark = stored === 'dark' || (!stored && mq.matches);
        document.documentElement.classList.toggle('dark', dark);
        // Follow system theme changes when user hasn't manually overridden
        mq.addEventListener('change', function (e) {
          if (!localStorage.getItem('theme')) {
            document.documentElement.classList.add('theme-transitioning');
            document.documentElement.classList.toggle('dark', e.matches);
            setTimeout(function () {
              document.documentElement.classList.remove('theme-transitioning');
            }, 450);
          }
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/hyprfm.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    {/* Open Graph / Twitter cards */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site?.toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="HyprFM" />
    <meta property="og:image" content={new URL('/screenshots/grid-view.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/screenshots/grid-view.png', Astro.site)} />
    <meta name="theme-color" content="#0a0c10" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'HyprFM', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Linux (Wayland)', license: 'https://opensource.org/license/mit', url: Astro.site?.toString(), downloadUrl: 'https://github.com/soyeb-jim285/hyprfm/releases', description })}></script>
  </head>
  <body class="min-h-screen antialiased">
    <slot />

    {/* Scroll-reveal: toggle `.is-visible` on any `.reveal` element when it
        enters the viewport. Uses IntersectionObserver so it's cheap and
        accessible (respects prefers-reduced-motion in CSS). */}
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      })();
    </script>
  </body>
</html>
