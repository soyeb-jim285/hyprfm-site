---
import '../styles/global.css';
import themes from '../data/themes.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'HyprFM: a fast, keyboard-first file manager for Hyprland',
  description = 'A Qt 6 file manager for Hyprland and Wayland: Miller columns, a preview for every file, Space to quick-preview anything, ten live-reloading themes, and nothing that needs a mouse.',
} = Astro.props;
const og = new URL('/media/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    {/* Before first paint: restore a theme the visitor picked (one of HyprFM's
        own palettes), else follow the system light/dark preference. */}
    <script is:inline define:vars={{ themes }}>
      document.documentElement.classList.add('js');
      window.HYPRFM_THEMES = themes;
      // Copy one of HyprFM's theme palettes onto the page. `animate` cross-fades.
      window.applyHyprTheme = function (id, animate) {
        var t = themes.find(function (x) { return x.id === id; });
        if (!t) return;
        var r = document.documentElement;
        if (animate) { r.classList.add('theme-shift'); setTimeout(function () { r.classList.remove('theme-shift'); }, 500); }
        Object.keys(t).forEach(function (k) { if (k !== 'id') r.style.setProperty('--' + k, t[k]); });
        r.dataset.mode = /latte|light|dawn/.test(t.id) ? 'light' : 'dark';
        r.dataset.theme = t.id;
        try { localStorage.setItem('hyprfm-theme', t.id); } catch (e) {}
        document.dispatchEvent(new CustomEvent('hyprfm-theme', { detail: t.id }));
      };
      try {
        var saved = localStorage.getItem('hyprfm-theme');
        if (saved) window.applyHyprTheme(saved, false);
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/hyprfm.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site?.toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="HyprFM" />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="theme-color" content="#11111b" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'HyprFM', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Linux (Wayland)', license: 'https://opensource.org/license/mit', url: Astro.site?.toString(), downloadUrl: 'https://github.com/soyeb-jim285/hyprfm/releases', description })}></script>
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('is-visible'); }); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
