---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · HyprFM" description="The requested HyprFM page could not be found.">
  <main class="nf shell">
    <p class="eyebrow">No such file or directory</p>
    <h1>404</h1>
    <p class="msg">This path does not exist, or it moved. Even Ctrl+Z cannot bring it back.</p>
    <a href="/">Back to ~</a>
  </main>
</Base>

<style>
  .nf { min-height: 100vh; display: grid; place-content: center; justify-items: start; gap: 20px; }
  h1 { font: 400 clamp(7rem, 24vw, 16rem)/.8 var(--display); color: var(--accent); }
  .msg { color: var(--subtext); max-width: 40ch; }
  a { font-weight: 700; color: var(--crust); background: var(--text); padding: 12px 18px; border-radius: 10px; text-decoration: none; }
</style>
