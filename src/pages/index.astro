---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Tour from '../components/Tour.astro';
import QuickPreview from '../components/QuickPreview.astro';
import Views from '../components/Views.astro';
import NoMouse from '../components/NoMouse.astro';
import Themes from '../components/Themes.astro';
import Customize from '../components/Customize.astro';
import Speed from '../components/Speed.astro';
import Shortcuts from '../components/Shortcuts.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';
import { getLatestVersion } from '../lib/version';

const version = await getLatestVersion();
---

<Base>
  <a href="#main" class="skip">Skip to content</a>
  <Nav version={version} />
  <main id="main">
    <Hero version={version} />
    <Tour />
    <QuickPreview />
    <Views />
    <NoMouse />
    <Themes />
    <Customize />
    <Speed />
    <Shortcuts />
    <Install version={version} />
  </main>
  <Footer />
</Base>
